<tr><td>open</td><td>chrome://newtab/<datalist><option>chrome://newtab/</option></datalist></td><td></td></tr>
<tr><td>open</td><td>http://localhost:4200/<datalist><option>http://localhost:4200/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=login-username<datalist><option>id=login-username</option><option>name=username</option><option>xpath=//input[@id='login-username']</option><option>xpath=//input</option><option>css=#login-username</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=login-username<datalist><option>id=login-username</option><option>name=username</option><option>xpath=//input[@id='login-username']</option><option>xpath=//input</option><option>css=#login-username</option></datalist></td><td>admin</td></tr>
<tr><td>click</td><td>id=login-password<datalist><option>id=login-password</option><option>name=password</option><option>xpath=//input[@id='login-password']</option><option>xpath=//input[2]</option><option>css=#login-password</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=login-password<datalist><option>id=login-password</option><option>name=password</option><option>xpath=//input[@id='login-password']</option><option>xpath=//input[2]</option><option>css=#login-password</option></datalist></td><td>admin123</td></tr>
<tr><td>click</td><td>xpath=//button[@type='submit']<datalist><option>xpath=//button[@type='submit']</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Password'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Username'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Registruj se'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Katalon Recorder is recording ...'])[1]/preceding::button[1]</option><option>xpath=//button</option><option>css=button[type="submit"]</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//button[@type='button']<datalist><option>xpath=//button[@type='button']</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Admin'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Moj profil'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Biblioteka'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Pretraži knjige po naslovu'])[1]/preceding::button[1]</option><option>xpath=//*/text()[normalize-space(.)='Logout']/parent::*</option><option>xpath=//button</option><option>css=button[type="button"]</option></datalist></td><td></td></tr>
